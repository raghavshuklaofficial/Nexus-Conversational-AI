# Nexus Conversational AI — Environment Variables
# =================================================
# Copy to .env and configure. NEVER commit .env.

# ---- Application ----
NEXUS_ENVIRONMENT=development
NEXUS_DEBUG=true
NEXUS_LOG_LEVEL=INFO
NEXUS_LOG_FORMAT=console

# ---- API ----
NEXUS_API_HOST=0.0.0.0
NEXUS_API_PORT=8000
NEXUS_API_API_KEY=
NEXUS_API_RATE_LIMIT_PER_MINUTE=60
NEXUS_API_ALLOWED_ORIGINS=["*"]

# ---- Cache ----
NEXUS_CACHE_BACKEND=memory
NEXUS_CACHE_REDIS_URL=redis://localhost:6379/0
NEXUS_CACHE_DEFAULT_TTL=3600

# ---- Vector Store ----
NEXUS_VECTOR_STORE_BACKEND=qdrant
NEXUS_QDRANT_URL=http://localhost:6333
NEXUS_QDRANT_API_KEY=

# ---- LLM ----
NEXUS_LLM_PROVIDER=local
NEXUS_LLM_MODEL=gpt2
# NEXUS_LLM_PROVIDER=openai
# NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
# NEXUS_OPENAI_API_KEY=sk-...
# NEXUS_OPENAI_MODEL=gpt-3.5-turbo

# ---- NLU Models ----
NEXUS_NLU_INTENT_MODEL=sentence-transformers/all-MiniLM-L6-v2
NEXUS_NLU_ENTITY_MODEL=dslim/bert-base-NER
NEXUS_NLU_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
NEXUS_NLU_DEVICE=auto

# ---- Kafka ----
NEXUS_KAFKA_ENABLED=false
NEXUS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Monitoring ----
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme
