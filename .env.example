# Nexus Conversational AI - Environment Variables
# =================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Grafana (monitoring profile)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# Application
NEXUS_ENVIRONMENT=production
NEXUS_DEBUG=false
NEXUS_HOST=0.0.0.0
NEXUS_PORT=8000
NEXUS_LOG_LEVEL=INFO

# Redis (if using redis cache backend)
# REDIS_URL=redis://localhost:6379/0

# Deployment (used by deploy.sh)
# DOMAIN=yourdomain.com
# SSL_EMAIL=you@email.com
